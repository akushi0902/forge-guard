.claude/
CLAUDE.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
pip-wheel-metadata/
.pip-cache/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Ruff / linting
.ruff_cache/

# Mypy / type checking
.mypy_cache/
.dmypy.json

# Alembic — migration version files must be committed; exclude only scratch files
# (no exclusion of .py files here — Alembic migrations are version-controlled)

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.dockerignore

# TLS certificates — generated by scripts/generate-dev-certs.sh or ui/nginx/generate-certs.sh
# Run 'make certs' to regenerate.
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key
ui/nginx/ssl/*.pem
ui/nginx/ssl/*.crt
ui/nginx/ssl/*.key

# Node / frontend (for future WOs)
node_modules/
.npm/
dist/
.next/
.nuxt/

# Logs
*.log
logs/

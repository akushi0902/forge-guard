# ForgeGuard Environment Configuration
# ======================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it is in .gitignore.
# This .env.example with safe placeholder values is safe to commit.
#
# Minimum Docker Compose version required: 2.20+
# (required for depends_on condition: service_completed_successfully)

# --------------------------------------------------------------------------
# PostgreSQL — used by both the database container and the backend
# --------------------------------------------------------------------------

# Superuser credentials for the postgres container initialisation.
POSTGRES_USER=forgeguard
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=forgeguard_dev

# Async DSN consumed by the FastAPI backend and Alembic migrations.
# Must use the 'postgresql+asyncpg://' driver prefix.
DATABASE_URL=postgresql+asyncpg://forgeguard:changeme_in_production@forgeguard-db:5432/forgeguard_dev

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------

# Secret key used to sign JWT access tokens.
# Generate a strong random value for production:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Deployment environment label: development | staging | production
APP_ENV=development

# Application version string (matches pyproject.toml).
APP_VERSION=0.1.0

# --------------------------------------------------------------------------
# AI / LLM integration
# --------------------------------------------------------------------------

# API key for the configured LLM provider (Anthropic, OpenAI, etc.).
# Leave empty to disable AI features and use template fallbacks.
LLM_API_KEY=

# --------------------------------------------------------------------------
# Forge Platform integration
# --------------------------------------------------------------------------

# Base URL of the Forge Catalog API for repository metadata sync.
FORGE_CATALOG_URL=https://forge.example.com/catalog

# --------------------------------------------------------------------------
# TLS / Nginx (local development)
# --------------------------------------------------------------------------

# Run 'make certs' or 'scripts/generate-dev-certs.sh' to generate these.
# The paths are relative to the nginx/ssl/ directory.
# SSL_CERT_PATH and SSL_KEY_PATH are used by nginx/nginx.conf.
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
